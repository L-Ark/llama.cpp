# GLM-5.1 UD-IQ3_XXS low-host-RAM profile.
# Measured on RTX 5090 under systemd MemoryMax=2G with expert-pack direct IO.
export CHAT_N_GPU_LAYERS=79
export GGML_MOE_RAM_TIER_MIB=0
export GGML_MOE_RAM_TIER_SKIP=0
export GGML_MOE_VRAM_CACHE_MIB=8192
export GGML_MOE_VRAM_CACHE_UPGATE_PCT=60
export GGML_MOE_VRAM_CACHE_POLICY=lfu_lru
export GGML_MOE_VRAM_PROFILE=presets/moe/groundtruth/wici-glm51-interactive-n84-expert-top8.runtime.csv
export GGML_MOE_VRAM_PROFILE_PROTECT=1
export GGML_MOE_VRAM_PROFILE_RESERVE_PCT=10
export GGML_MOE_IO_BACKEND=direct
export GGML_MOE_STAGE_PINNED=0
export LLAMA_CHAT_STARTUP_PROFILE_PRELOAD_TENSORS=3
