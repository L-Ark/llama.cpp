+    class DiskIouringBouncePool {
+    public:
+        DiskIouringBouncePool(int depth, uint64_t unitBytes) : unitBytes(unitBytes) {
+            buffers.resize(depth, nullptr);
+            for (int i = 0; i < depth; i++) {
+                void *ptr = nullptr;
+                if (posix_memalign(&ptr, 4096, unitBytes) != 0 || ptr == nullptr) {
+                    ErrorInFastLLM("Disk MoE io_uring bounce buffer allocation failed.\n");
+                }
+                buffers[i] = (uint8_t*)ptr;
+            }
+        }
+
+        ~DiskIouringBouncePool() {
+            for (uint8_t *ptr : buffers) {
+                free(ptr);
+            }
+        }
+
+        uint8_t *operator[](size_t i) {
+            return buffers[i];
+        }
+
+        size_t Size() const {
+            return buffers.size();
+        }
+
+        uint64_t UnitBytes() const {
+            return unitBytes;
+        }
+
+    private:
+        std::vector<uint8_t*> buffers;
+        uint64_t unitBytes;
+    };
+
+    static bool SubmitDiskIouringRead(io_uring &ring, int fd, DiskIouringPending &pending,
+                                      int slot, const DiskIouringChunk &chunk) {
+        io_uring_sqe *sqe = io_uring_get_sqe(&ring);
+        if (sqe == nullptr) {
+            int submitted = io_uring_submit(&ring);
+            if (submitted < 0) {
+                return false;
+            }
+            GetDiskMoeStats().iouringSubmits.fetch_add(1, std::memory_order_relaxed);
+            sqe = io_uring_get_sqe(&ring);
+            if (sqe == nullptr) {
+                return false;
+            }
+        }
+        pending.active = true;
+        pending.chunk = chunk;
+        io_uring_prep_read(sqe, fd, pending.bounce, (unsigned int)chunk.bytes,
+                           chunk.task->part->fileOffset + (long long)chunk.taskOffset);
+        io_uring_sqe_set_data64(sqe, (uint64_t)slot + 1);
+        return true;
+    }
+
+    static bool ReadDiskTasksIouring(const std::vector<DiskReadTask> &tasks) {
+        if (tasks.empty()) {
+            return true;
+        }
+        uint64_t startNs = DiskMoeStatsEnabled() ? DiskMoeNowNs() : 0;
+        int depth = std::max(1, DiskMoeIouringQueueDepth());
+        uint64_t unitBytes = DiskMoeIouringUnitBytes();
+        io_uring ring;
+        if (io_uring_queue_init((unsigned int)depth, &ring, 0) < 0) {
+            GetDiskMoeStats().iouringFallbacks.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        }
+
+        bool ok = true;
+        uint64_t readBytes = 0;
+        uint64_t completions = 0;
+        uint64_t readCalls = 0;
+        std::vector<DiskIouringChunk> chunks;
+        chunks.reserve(tasks.size());
+        for (const DiskReadTask &task : tasks) {
+            uint64_t offset = 0;
+            while (offset < task.bytes) {
+                uint64_t chunkBytes = std::min(unitBytes, task.bytes - offset);
+                chunks.push_back({&task, offset, chunkBytes});
+                offset += chunkBytes;
+            }
+        }
+
+        DiskIouringBouncePool bounces(depth, unitBytes);
+        std::vector<DiskIouringPending> pending(depth);
+        for (int i = 0; i < depth; i++) {
+            pending[i].bounce = bounces[i];
+        }
+
+        size_t next = 0;
+        size_t submitted = 0;
+        size_t completed = 0;
+        while (submitted < (size_t)depth && next < chunks.size()) {
+            int slot = (int)submitted;
+            int fd = GetDiskDirectFileCache().Get(chunks[next].task->part->fileName);
+            if (!SubmitDiskIouringRead(ring, fd, pending[slot], slot, chunks[next])) {
+                ok = false;
+                break;
+            }
+            next++;
+            submitted++;
+        }
+        if (ok && submitted > 0) {
+            int ret = io_uring_submit(&ring);
+            if (ret < 0) {
+                ok = false;
+            } else {
+                GetDiskMoeStats().iouringSubmits.fetch_add(1, std::memory_order_relaxed);
+            }
+        }
+
+        while (ok && completed < submitted) {
+            io_uring_cqe *cqe = nullptr;
+            int ret = io_uring_wait_cqe(&ring, &cqe);
+            if (ret < 0 || cqe == nullptr) {
+                ok = false;
+                break;
+            }
+            uint64_t userData = io_uring_cqe_get_data64(cqe);
+            if (userData == 0 || userData > (uint64_t)pending.size()) {
+                io_uring_cqe_seen(&ring, cqe);
+                ok = false;
+                break;
+            }
+            int slot = (int)userData - 1;
+            DiskIouringPending &entry = pending[slot];
+            int result = cqe->res;
+            io_uring_cqe_seen(&ring, cqe);
+            if (!entry.active || result < 0 || (uint64_t)result != entry.chunk.bytes) {
+                ok = false;
+                break;
+            }
+            memcpy(entry.chunk.task->dst + entry.chunk.taskOffset, entry.bounce, entry.chunk.bytes);
+            readBytes += entry.chunk.bytes;
+            readCalls++;
+            completions++;
+            completed++;
+            entry.active = false;
+
+            if (next < chunks.size()) {
+                int fd = GetDiskDirectFileCache().Get(chunks[next].task->part->fileName);
+                if (!SubmitDiskIouringRead(ring, fd, entry, slot, chunks[next])) {
+                    ok = false;
+                    break;
+                }
+                next++;
+                submitted++;
+                int submitRet = io_uring_submit(&ring);
+                if (submitRet < 0) {
+                    ok = false;
+                    break;
+                }
+                GetDiskMoeStats().iouringSubmits.fetch_add(1, std::memory_order_relaxed);
+            }
+        }
+
+        io_uring_queue_exit(&ring);
+        if (!ok) {
+            GetDiskMoeStats().iouringFallbacks.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        }
+        DiskMoeStats &stats = GetDiskMoeStats();
+        stats.iouringBatches.fetch_add(1, std::memory_order_relaxed);
+        stats.iouringCompletions.fetch_add(completions, std::memory_order_relaxed);
+        stats.iouringBytes.fetch_add(readBytes, std::memory_order_relaxed);
+        if (DiskMoeStatsEnabled()) {
+            stats.readCalls.fetch_add(readCalls, std::memory_order_relaxed);
+            stats.readBytes.fetch_add(readBytes, std::memory_order_relaxed);
+            uint64_t elapsed = DiskMoeNowNs() - startNs;
+            stats.readNs.fetch_add(elapsed, std::memory_order_relaxed);
+            stats.iouringNs.fetch_add(elapsed, std::memory_order_relaxed);
+        }
+        return true;
+    }
+#endif
