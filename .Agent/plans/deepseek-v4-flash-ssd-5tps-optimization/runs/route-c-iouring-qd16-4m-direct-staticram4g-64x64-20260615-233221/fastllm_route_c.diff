+    static void LoadDiskWeightsBatchWithRamCache(Data **weights,
+                                                 std::vector<Data*> &tempWeights,
+                                                 const std::vector<int> &indices) {
+        std::vector<std::unique_ptr<DiskWeightLoadPlan>> plans;
+        std::vector<const Data*> sourceWeights;
+        std::vector<int> targetIndices;
+        std::vector<DiskReadTask> readTasks;
+        plans.reserve(indices.size());
+        sourceWeights.reserve(indices.size());
+        targetIndices.reserve(indices.size());
+
+        for (int index : indices) {
+            if (Data *cached = GetDiskMoeRamWeightCache().Get(weights[index])) {
+                tempWeights[index] = cached;
+                continue;
+            }
+            std::unique_ptr<DiskWeightLoadPlan> plan(new DiskWeightLoadPlan(PrepareDiskWeightLoad(weights[index])));
+            for (const DiskReadTask &task : plan->readTasks) {
+                readTasks.push_back(task);
+            }
+            sourceWeights.push_back(weights[index]);
+            targetIndices.push_back(index);
+            plans.push_back(std::move(plan));
+        }
+
+        ReadDiskTasks(readTasks);
+
+        for (size_t i = 0; i < plans.size(); i++) {
+            FinishDiskWeightLoad(*plans[i]);
+            tempWeights[targetIndices[i]] = plans[i]->loaded;
+            GetDiskMoeRamWeightCache().Put(sourceWeights[i], plans[i]->loaded);
+        }
+    }
